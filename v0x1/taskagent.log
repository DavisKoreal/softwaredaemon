    "command": "writeToFile backend/utils/error_handler.py \"import logging\nimport traceback\nfrom flask import jsonify, request\nfrom functools import wraps\nimport sys\nimport os\n\n# Set up logging configuration\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',\n    handlers=[\n        logging.FileHandler('backend/logs/server.log'),\n        logging.StreamHandler(sys.stdout)\n    ]\n)\n\nlogger = logging.getLogger(__name__)\n\ndef setup_error_handlers(app):\n    \\\"\\\"\\\"Set up global error handlers for the Flask application\\\"\\\"\\\"\n    \n    @app.errorhandler(400)\n    def bad_request_error(error):\n        logger.warning(f'Bad request: {request.url} - {str(error)}')\n        return jsonify({\n            'success': False,\n            'error': 'Bad request',\n            'message': 'The request was malformed or missing required parameters',\n            'status_code': 400\n        }), 400\n\n    @app.errorhandler(404)\n    def not_found_error(error):\n        logger.warning(f'Endpoint not found: {request.url}')\n        return jsonify({\n            'success': False,\n            'error': 'Endpoint not found',\n            'message': 'The requested endpoint does not exist',\n            'status_code': 404\n        }), 404\n\n    @app.errorhandler(405)\n    def method_not_allowed_error(error):\n        logger.warning(f'Method not allowed: {request.method} {request.url}')\n        return jsonify({\n            'success': False,\n            'error': 'Method not allowed',\n            'message': 'The HTTP method is not supported for this endpoint',\n            'status_code': 405\n        }), 405\n\n    @app.errorhandler(500)\n    def internal_server_error(error):\n        logger.error(f'Internal server error: {str(error)}')\n        logger.error(traceback.format_exc())\n        return jsonify({\n            'success': False,\n            'error': 'Internal server error',\n            'message': 'An unexpected error occurred on the server',\n            'status_code': 500\n        }), 500\n\n    @app.errorhandler(Exception)\n    def handle_unexpected_error(error):\n        logger.critical(f'Unexpected error: {str(error)}')\n        logger.critical(traceback.format_exc())\n        return jsonify({\n            'success': False,\n            'error': 'Unexpected server error',\n            'message': 'An unexpected error occurred',\n            'status_code': 500\n        }), 500\n\ndef log_request_info():\n    \\\"\\\"\\\"Log information about incoming requests\\\"\\\"\\\"\n    logger.info(f'Request: {request.method} {request.url}')\n    logger.info(f'Remote address: {request.remote_addr}')\n    logger.info(f'User agent: {request.user_agent}')\n    \n    if request.method in ['POST', 'PUT', 'PATCH']:\n        # Log request data (be careful with sensitive information)\n        if request.is_json:\n            logger.debug(f'Request JSON data: {request.get_json()}')\n        elif request.form:\n            logger.debug(f'Request form data: {dict(request.form)}')\n\ndef log_response_info(response):\n    \\\"\\\"\\\"Log information about outgoing responses\\\"\\\"\\\"\n    logger.info(f'Response status: {response.status_code}')\n    return response\n\ndef error_handler(func):\n    \\\"\\\"\\\"Decorator for handling errors in route functions\\\"\\\"\\\"\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        try:\n            # Log request info before processing\n            log_request_info()\n            \n            # Execute the function\n            result = func(*args, **kwargs)\n            \n            # Log successful response\n            logger.info(f'Route {func.__name__} executed successfully')\n            \n            return result\n            \n        except ValueError as e:\n            logger.warning(f'Value error in {func.__name__}: {str(e)}')\n            return jsonify({\n                'success': False,\n                'error': 'Invalid input',\n                'message': str(e)\n            }), 400\n            \n        except FileNotFoundError as e:\n            logger.warning(f'File not found in {func.__name__}: {str(e)}')\n            return jsonify({\n                'success': False,\n                'error': 'File not found',\n                'message': str(e)\n            }), 404\n            \n        except PermissionError as e:\n            logger.error(f'Permission error in {func.__name__}: {str(e)}')\n            return jsonify({\n                'success': False,\n                'error': 'Permission denied',\n                'message': 'Insufficient permissions to access the resource'\n            }), 403\n            \n        except Exception as e:\n            logger.error(f'Unexpected error in {func.__name__}: {str(e)}')\n            logger.error(traceback.format_exc())\n            return jsonify({\n                'success': False,\n                'error': 'Internal server error',\n                'message': 'An unexpected error occurred while processing the request'\n            }), 500\n    \n    return wrapper\n\nclass RequestLogger:\n    \\\"\\\"\\\"Middleware for logging HTTP requests and responses\\\"\\\"\\\"\n    \n    def __init__(self, app):\n        self.app = app\n        \n    def __call__(self, environ, start_response):\n        # Log request details\n        request_method = environ.get('REQUEST_METHOD', '')\n        request_path = environ.get('PATH_INFO', '')\n        remote_addr = environ.get('REMOTE_ADDR', '')\n        \n        logger.info(f'Incoming request: {request_method} {request_path} from {remote_addr}')\n        \n        def custom_start_response(status, headers, *args):\n            # Log response status\n            logger.info(f'Response status: {status}')\n            return start_response(status, headers, *args)\n        \n        return self.app(environ, custom_start_response)\n\ndef setup_logging_middleware(app):\n    \\\"\\\"\\\"Set up logging middleware for the Flask app\\\"\\\"\\\"\n    app.wsgi_app = RequestLogger(app.wsgi_app)\n    \n    # Add after_request handler for response logging\n    @app.after_request\n    def after_request_logging(response):\n        return log_response_info(response)\n\ndef log_server_startup():\n    \\\"\\\"\\\"Log server startup information\\\"\\\"\\\"\n    logger.info('=' * 50)\n    logger.info('Log Parser API Server Starting')\n    logger.info('=' * 50)\n    logger.info(f'Python version: {sys.version}')\n    logger.info(f'Working directory: {os.getcwd()}')\n    logger.info(f'Server process ID: {os.getpid()}')\n\ndef log_server_shutdown():\n    \\\"\\\"\\\"Log server shutdown information\\\"\\\"\\\"\n    logger.info('=' * 50)\n    logger.info('Log Parser API Server Shutting Down')\n    logger.info('=' * 50)\n\n# Custom exception classes for specific error scenarios\nclass LogParseError(Exception):\n    \\\"\\\"\\\"Custom exception for log parsing errors\\\"\\\"\\\"\n    def __init__(self, message, log_line=None):\n        self.message = message\n        self.log_line = log_line\n        super().__init__(self.message)\n\nclass FileProcessingError(Exception):\n    \\\"\\\"\\\"Custom exception for file processing errors\\\"\\\"\\\"\n    def __init__(self, message, file_path=None):\n        self.message = message\n        self.file_path = file_path\n        super().__init__(self.message)\n\nclass ValidationError(Exception):\n    \\\"\\\"\\\"Custom exception for data validation errors\\\"\\\"\\\"\n    def __init__(self, message, field=None):\n        self.message = message\n        self.field = field\n        super().__init__(self.message)\n\n# Utility functions for specific error scenarios\ndef handle_log_parse_error(error, log_data=None):\n    \\\"\\\"\\\"Handle log parsing specific errors\\\"\\\"\\\"\n    logger.error(f'Log parsing error: {error}')\n    if log_data:\n        logger.debug(f'Problematic log data: {log_data}')\n    \n    return {\n        'success': False,\n        'error': 'Log parsing failed',\n        'message': str(error),\n        'log_data': log_data if log_data else None\n    }\n\ndef handle_file_processing_error(error, file_info=None):\n    \\\"\\\"\\\"Handle file processing specific errors\\\"\\\"\\\"\n    logger.error(f'File processing error: {error}')\n    if file_info:\n        logger.debug(f'File info: {file_info}')\n    \n    return {\n        'success': False,\n        'error': 'File processing failed',\n        'message': str(error),\n        'file_info': file_info if file_info else None\n    }\n\n# Test the error handler\ndef test_error_handling():\n    \\\"\\\"\\\"Test function to verify error handling works correctly\\\"\\\"\\\"\n    try:\n        # Simulate different types of errors\n        raise ValueError('Test validation error')\n    except ValueError as e:\n        logger.warning(f'Test: Caught ValueError: {e}')\n    \n    try:\n        raise FileNotFoundError('Test file not found')\n    except FileNotFoundError as e:\n        logger.warning(f'Test: Caught FileNotFoundError: {e}')\n    \n    logger.info('Error handling test completed successfully')\n\nif __name__ == '__main__':\n    test_error_handling()\""
}
