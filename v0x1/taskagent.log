  "atomic": "true",
  "command": "writeToFile backend/models/log_models.py \"from typing import List, Dict, Any, Optional, Union\nfrom datetime import datetime\nfrom dataclasses import dataclass, asdict\nimport json\n\n@dataclass\nclass LogEntry:\n    \"\"\"Data model for a single parsed log entry\"\"\"\n    timestamp: Optional[str]\n    timestamp_str: str\n    message: str\n    type: str\n    task: Optional[str] = None\n    json_data: Optional[Dict[str, Any]] = None\n    \n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for JSON serialization\"\"\"\n        return asdict(self)\n\n@dataclass\nclass TaskData:\n    \"\"\"Data model for task information extracted from logs\"\"\"\n    task_name: str\n    subtasks: List[str]\n    atomic: Optional[str] = None\n    command: Optional[str] = None\n    timestamp: Optional[str] = None\n    \n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for JSON serialization\"\"\"\n        return asdict(self)\n\n@dataclass\nclass LogParseResponse:\n    \"\"\"Data model for API response when parsing logs\"\"\"\n    success: bool\n    parsed_logs: List[LogEntry]\n    tasks: Dict[str, TaskData]\n    total_logs: int\n    total_tasks: int\n    file_path: Optional[str] = None\n    error: Optional[str] = None\n    \n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for JSON serialization\"\"\"\n        return {\n            'success': self.success,\n            'parsed_logs': [log.to_dict() for log in self.parsed_logs],\n            'tasks': {task_name: task_data.to_dict() for task_name, task_data in self.tasks.items()},\n            'total_logs': self.total_logs,\n            'total_tasks': self.total_tasks,\n            'file_path': self.file_path,\n            'error': self.error\n        }\n    \n    def to_json(self) -> str:\n        \"\"\"Convert to JSON string\"\"\"\n        return json.dumps(self.to_dict(), indent=2, ensure_ascii=False)\n\n@dataclass\nclass LogStatistics:\n    \"\"\"Data model for log statistics\"\"\"\n    total_logs_processed: int\n    total_tasks_extracted: int\n    log_types_distribution: Dict[str, int]\n    recent_activity: List[Dict[str, Any]]\n    \n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for JSON serialization\"\"\"\n        return asdict(self)\n\n@dataclass\nclass ApiResponse:\n    \"\"\"Generic API response model\"\"\"\n    success: bool\n    message: str\n    data: Optional[Dict[str, Any]] = None\n    error: Optional[str] = None\n    \n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for JSON serialization\"\"\"\n        result = {\n            'success': self.success,\n            'message': self.message\n        }\n        if self.data:\n            result['data'] = self.data\n        if self.error:\n            result['error'] = self.error\n        return result\n\n@dataclass\nclass FileUploadResponse:\n    \"\"\"Data model for file upload response\"\"\"\n    success: bool\n    filename: str\n    parsed_logs: List[LogEntry]\n    tasks: Dict[str, TaskData]\n    total_logs: int\n    total_tasks: int\n    error: Optional[str] = None\n    \n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for JSON serialization\"\"\"\n        return {\n            'success': self.success,\n            'filename': self.filename,\n            'parsed_logs': [log.to_dict() for log in self.parsed_logs],\n            'tasks': {task_name: task_data.to_dict() for task_name, task_data in self.tasks.items()},\n            'total_logs': self.total_logs,\n            'total_tasks': self.total_tasks,\n            'error': self.error\n        }\n\n@dataclass\nclass LogTypeInfo:\n    \"\"\"Data model for log type information\"\"\"\n    available_types: List[str]\n    type_counts: Dict[str, int]\n    \n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for JSON serialization\"\"\"\n        return asdict(self)\n\n# Helper functions for creating response objects\ndef create_success_response(data: Dict[str, Any] = None, message: str = \"Success\") -> Dict[str, Any]:\n    \"\"\"Create a standard success response\"\"\"\n    response = ApiResponse(success=True, message=message, data=data)\n    return response.to_dict()\n\ndef create_error_response(error: str, message: str = \"Error occurred\") -> Dict[str, Any]:\n    \"\"\"Create a standard error response\"\"\"\n    response = ApiResponse(success=False, message=message, error=error)\n    return response.to_dict()\n\ndef create_log_parse_response(\n    parsed_logs: List[LogEntry],\n    tasks: Dict[str, TaskData],\n    file_path: Optional[str] = None,\n    success: bool = True,\n    error: Optional[str] = None\n) -> Dict[str, Any]:\n    \"\"\"Create a standardized log parse response\"\"\"\n    response = LogParseResponse(\n        success=success,\n        parsed_logs=parsed_logs,\n        tasks=tasks,\n        total_logs=len(parsed_logs),\n        total_tasks=len(tasks),\n        file_path=file_path,\n        error=error\n    )\n    return response.to_dict()\n\ndef create_file_upload_response(\n    filename: str,\n    parsed_logs: List[LogEntry],\n    tasks: Dict[str, TaskData],\n    success: bool = True,\n    error: Optional[str] = None\n) -> Dict[str, Any]:\n    \"\"\"Create a standardized file upload response\"\"\"\n    response = FileUploadResponse(\n        success=success,\n        filename=filename,\n        parsed_logs=parsed_logs,\n        tasks=tasks,\n        total_logs=len(parsed_logs),\n        total_tasks=len(tasks),\n        error=error\n    )\n    return response.to_dict()\n\n# Example usage and testing\ndef main():\n    \"\"\"Test the data models\"\"\"\n    \n    # Create sample log entries\n    log_entry1 = LogEntry(\n        timestamp=None,\n        timestamp_str=\"Wed May  7 19:25:50 2025\",\n        message=\"Generating sub task list for the task: sample task\",\n        type=\"task_generation\",\n        task=\"sample task\"\n    )\n    \n    log_entry2 = LogEntry(\n        timestamp=None,\n        timestamp_str=\"Wed May  7 19:25:59 2025\",\n        message=\"Response from the API\",\n        type=\"api_response\",\n        json_data={\"atomic\": \"false\", \"subtasks\": [\"subtask1\", \"subtask2\"]}\n    )\n    \n    # Create sample task data\n    task_data = TaskData(\n        task_name=\"sample task\",\n        subtasks=[\"subtask1\", \"subtask2\"],\n        atomic=\"false\",\n        timestamp=\"Wed May  7 19:25:50 2025\"\n    )\n    \n    # Create sample response\n    response = LogParseResponse(\n        success=True,\n        parsed_logs=[log_entry1, log_entry2],\n        tasks={\"sample task\": task_data},\n        total_logs=2,\n        total_tasks=1\n    )\n    \n    print(\"Sample Log Entry:\")\n    print(json.dumps(log_entry1.to_dict(), indent=2))\n    \n    print(\"\\nSample Task Data:\")\n    print(json.dumps(task_data.to_dict(), indent=2))\n    \n    print(\"\\nSample API Response:\")\n    print(json.dumps(response.to_dict(), indent=2))\n    \n    print(\"\\nSample Success Response:\")\n    print(json.dumps(create_success_response({\"test\": \"data\"}), indent=2))\n\nif __name__ == \"__main__\":\n    main()\""
