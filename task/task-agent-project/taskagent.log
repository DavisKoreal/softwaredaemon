#include <cmath>

class Transistor {
private:
    double beta;  // Current gain
    double v_be;  // Base-emitter voltage
    double i_s;   // Saturation current

public:
    Transistor(double b, double v, double is) : beta(b), v_be(v), i_s(is) {}

    // Calculate collector current using Ebers-Moll model
    double calculateCollectorCurrent(double v_ce) {
        // Simplified model: Ic = beta * Ib
        // Using diode equation for base-emitter junction
        double i_b = i_s * (exp(v_be / 0.026) - 1);  // Thermal voltage ~26mV
        double i_c = beta * i_b;
        
        // Account for saturation region
        if (v_ce < 0.2) {  // Saturation voltage
            i_c = i_c * (v_ce / 0.2);
        }
        
        return i_c;
    }

    void setBaseEmitterVoltage(double voltage) {
        v_be = voltage;
    }
};

int main() {
    // Create a transistor with beta=100, V_be=0.7V, I_s=1e-12A
    Transistor transistor(100.0, 0.7, 1e-12);
    
    std::cout << \"Transistor Simulation\" << std::endl;
    std::cout << \"====================\" << std::endl;
    
    // Test different collector-emitter voltages
    for (double v_ce = 0.0; v_ce <= 5.0; v_ce += 0.5) {
        double i_c = transistor.calculateCollectorCurrent(v_ce);
        std::cout << \"V_ce: \" << v_ce << \"V, I_c: \" << i_c * 1000 << \"mA\" << std::endl;
    }
    
    // Test different base-emitter voltages
    std::cout << \"\\nTesting different base-emitter voltages:\" << std::endl;
    for (double v_be = 0.6; v_be <= 0.8; v_be += 0.05) {
        transistor.setBaseEmitterVoltage(v_be);
        double i_c = transistor.calculateCollectorCurrent(5.0);
        std::cout << \"V_be: \" << v_be << \"V, I_c: \" << i_c * 1000 << \"mA\" << std::endl;
    }
    
    return 0;
}
''')"
